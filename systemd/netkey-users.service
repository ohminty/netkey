[Unit]
Description=Apply netkey dial-in users to /etc/ppp/pap-secrets
Documentation=file:///opt/netkey/README.md

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/netkey/modem.py --config /etc/netkey/config.toml --sync-pap-secrets --state-dir /var/lib/netkey
SyslogIdentifier=netkey-users
# root only to write /etc/ppp/pap-secrets from the user list the web GUI exports: nothing else
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/ppp /var/lib/netkey
ProtectSystem=strict
PrivateNetwork=yes
PrivateDevices=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

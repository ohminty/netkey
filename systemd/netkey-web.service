[Unit]
Description=netkey web GUI (dashboard, dial-in users, settings) and stats collector
Documentation=file:///opt/netkey/README.md
After=network-online.target local-fs.target
Wants=network-online.target
PartOf=netkey.target

[Service]
Type=simple
User=netkey
Group=netkey
# the shared folder (/srv/netkey) belongs to netkey-share; the GUI uploads into it
SupplementaryGroups=netkey-share
ReadWritePaths=-/srv/netkey
StateDirectory=netkey
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /opt/netkey/modem.py --config /etc/netkey/config.toml --web --run-dir /run/netkey
Restart=always
RestartSec=3
SyslogIdentifier=netkey-web
# ports 80/443 without root; this unit runs no setuid programs, so it can be locked down
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0027

[Install]
WantedBy=netkey.target

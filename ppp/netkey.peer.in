# netkey line {line} PPP server (generated by install.sh from ppp/netkey.peer.in; do not edit).
# Started by modem.py --line {line} as: pppd call netkey{line} <baud>
# The tty is stdin (the serial fd handed over after CONNECT). /etc/ppp/options is read
# first and sets crtscts/modem on Debian, so those are overridden here.
local
nocrtscts
auth
require-pap
name {server_name}
{server_ip}:{client_ip}
unit {line}
noipv6
nodefaultroute
noproxyarp
noccp
asyncmap 0
ms-dns 1.1.1.1
ms-dns 8.8.8.8
lcp-echo-interval 20
lcp-echo-failure 3
nodetach
ipparam netkey{line}
hide-password
debug
